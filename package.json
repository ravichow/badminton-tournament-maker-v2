{
  "name": "badminton-tournament-maker-v2",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "pages:dev": "wrangler pages dev dist",
    "d1:init:local": "wrangler d1 execute badminton-tournament-maker-v2-db --local --file=./schema.sql",
    "d1:init:remote": "wrangler d1 execute badminton-tournament-maker-v2-db --remote --file=./schema.sql --yes",
    "pages:deploy": "wrangler pages deploy dist --project-name=badminton-tournament-maker --branch=main"
  },
  "dependencies": {
    "html2canvas": "^1.4.1",
    "jspdf": "^2.5.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20241022.0",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "autoprefixer": "^10.4.19",
    "postcss": "^8.4.38",
    "tailwindcss": "^3.4.4",
    "typescript": "^5.2.2",
    "vite": "^5.3.1",
    "vitest": "^2.1.9",
    "wrangler": "^3.80.5"
  }
}
